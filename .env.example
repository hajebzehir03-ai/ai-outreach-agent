# ============================================================
# AI Outreach Agent — Environment Variables
# Copia questo file in .env e compila i valori
# MAI committare .env su git
# ============================================================

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith (tracing agenti — gratis per uso personale)
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ai-outreach-agent

# Database PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/outreach_agent

# Email — Resend
RESEND_API_KEY=re_...
OUTREACH_FROM_EMAIL=zehir@tuodominio-outreach.it
OUTREACH_FROM_NAME=Zehir

# Notifiche (opzionale — Telegram per alert lead caldi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Places API (sourcing PMI)
GOOGLE_PLACES_API_KEY=AIza...

# Tavily (ricerca semantica web — opzionale)
TAVILY_API_KEY=tvly-...

# App settings
ENVIRONMENT=development
MAX_EMAILS_PER_DAY=30
APPROVAL_REQUIRED=true
KILL_SWITCH=false
